# Hosted web app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters

# Legacy OAuth dashboard (optional during migration)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional GitHub App advanced layer
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# Optional durable webhook history for self-hosted deployments.
# Point this at a persistent volume. Leave unset on ephemeral/serverless filesystems.
GITHUB_APP_HISTORY_PATH=
